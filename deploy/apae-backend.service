[Unit]
Description=Central da Secretaria APAE (back Spring Boot)
After=network.target postgresql.service
Requires=postgresql.service

[Service]
Type=simple
User=apae
Group=apae
WorkingDirectory=/opt/apae/back
EnvironmentFile=/etc/apae/apae.env
ExecStart=/usr/bin/java \
    -Xms128m -Xmx384m \
    -XX:MaxMetaspaceSize=160m \
    -XX:ReservedCodeCacheSize=48m \
    -XX:MaxDirectMemorySize=64m \
    -Xss512k \
    -XX:+UseSerialGC \
    -XX:+ExitOnOutOfMemoryError \
    -Dfile.encoding=UTF-8 \
    -jar /opt/apae/back/central-secretaria.jar
SuccessExitStatus=143
Restart=on-failure
RestartSec=10
MemoryHigh=560M
MemoryMax=600M
MemorySwapMax=0
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
